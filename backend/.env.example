# Copy to .env and adjust. All values are optional - sensible defaults apply.

# --- Server ---
PB_HOST=0.0.0.0
PB_PORT=8000
PB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
# Encrypts API keys at rest. Set a long random value in production.
PB_SECRET_KEY=
# Bearer token the Admin dashboard must send (Authorization: Bearer <token>).
PB_ADMIN_TOKEN=change-me-admin-token

# --- Camera / vision ---
PB_CAMERA_INDEX=0
PB_STREAM_WIDTH=1280
PB_STREAM_HEIGHT=720
PB_STREAM_FPS=20
PB_STREAM_JPEG_QUALITY=70
PB_FACE_DETECT_EVERY_N=15
PB_FACE_TOLERANCE=0.55

# --- Storage (defaults to ./data) ---
# PB_DATA_DIR=/home/pi/photobooth/data
# PB_DB_PATH=/home/pi/photobooth/data/photobooth.db
# Soft-saved guest photos, one sub-folder per date (defaults to <data>/photos).
# PB_PHOTOS_DIR=/home/pi/Pictures/pixel
